<!-- Official installer build; announce layout retained from the existing 7.11.0 profile. -->
<client name="BitTorrent 7.11.0 Build (47255)" author="RygTech" version="1.0" processname="bittorrent">
  <query>info_hash={infohash}&amp;peer_id={peerid}&amp;port={port}&amp;uploaded={uploaded}&amp;downloaded={downloaded}&amp;left={left}&amp;corrupt=0&amp;key={key}{event}&amp;numwant={numwant}&amp;compact=1&amp;no_peer_id=1</query>
  <headers>Host: {host}_nl_User-Agent: BitTorrent/7110(258062487)(47255)_nl_Accept-Encoding: gzip_nl_Connection: Close_nl_</headers>
  <peer_id prefix="-BT7b0S-%97%b8" type="random" length="10" urlencoding="true" upperCase="false" />
  <key type="hex" length="8" urlencoding="false" upperCase="true" />
  <protocol value="HTTP/1.1" />
  <hash upperCase="false" />
  <urlencoding exceptions="-" />
  <numwant value="200" randomize="false" />
</client>
