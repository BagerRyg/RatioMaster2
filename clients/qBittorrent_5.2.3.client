<client name="qBittorrent 5.2.3" author="RygTech" version="1.1" processname="qbittorrent">
  <query>info_hash={infohash}&amp;peer_id={peerid}&amp;port={port}&amp;uploaded={uploaded}&amp;downloaded={downloaded}&amp;left={left}&amp;corrupt=0&amp;key={key}{event}&amp;numwant={numwant}&amp;compact=1&amp;no_peer_id=1&amp;supportcrypto=1&amp;redundant=0</query>
  <headers>Host: {host}_nl_User-Agent: qBittorrent/5.2.3_nl_Accept-Encoding: gzip_nl_Connection: close_nl_</headers>
  <peer_id prefix="-qB5230-" type="qbittorrent" length="12" urlencoding="false" upperCase="false" value="" />
  <key type="hex" length="8" urlencoding="false" upperCase="true" value="" />
  <numwant value="200" randomize="false" />
  <protocol value="HTTP/1.1" />
  <hash upperCase="false" />
  <urlencoding exceptions="_~()!.*-" />
</client>
